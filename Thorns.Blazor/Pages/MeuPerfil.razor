@page "/meu-perfil"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Thorns.Blazor.Models
@inject UserService UserService

<PageTitle>Meu Perfil - Thorns</PageTitle>

<h1 class="mb-4">Meu Perfil</h1>

@if (carregando)
{
    <p>Carregando informações do perfil...</p>
}
else if (!string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-danger" role="alert">@erro</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(sucesso))
    {
        <div class="alert alert-success" role="status">@sucesso</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm Model="formulario" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label" for="nome">Nome</label>
                    <InputText id="nome" class="form-control" @bind-Value="formulario.Name" />
                    <ValidationMessage For="@(() => formulario.Name)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="email">E-mail</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="formulario.Email" />
                    <ValidationMessage For="@(() => formulario.Email)" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="cpf">CPF</label>
                        <InputText id="cpf" class="form-control" placeholder="000.000.000-00" @bind-Value="formulario.Cpf" />
                        <ValidationMessage For="@(() => formulario.Cpf)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="cep">CEP</label>
                        <InputText id="cep" class="form-control" placeholder="00000-000" @bind-Value="formulario.Cep" />
                        <ValidationMessage For="@(() => formulario.Cep)" />
                    </div>
                </div>

                <div class="mb-3">
                    <span class="form-label">Perfil de acesso:</span>
                    <span class="badge bg-primary">@perfil?.Role</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(erroSalvar))
                {
                    <div class="alert alert-danger" role="alert">@erroSalvar</div>
                }

                <button class="btn btn-primary" type="submit" disabled="@salvando">
                    @(salvando ? "Salvando..." : "Salvar alterações")
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly UserProfileForm formulario = new();
    private UserProfileResponse? perfil;
    private bool carregando = true;
    private bool salvando;
    private string erro = string.Empty;
    private string erroSalvar = string.Empty;
    private string sucesso = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            perfil = await UserService.GetOwnProfileAsync();
            if (perfil is null)
            {
                erro = "Não foi possível encontrar os dados do usuário.";
                return;
            }

            formulario.Name = perfil.Name;
            formulario.Email = perfil.Email;
            formulario.Cpf = perfil.Cpf;
            formulario.Cep = perfil.Cep;
        }
        catch (HttpRequestException exception)
        {
            erro = exception.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Sua sessão expirou. Entre novamente."
                : "Não foi possível carregar seu perfil.";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task SalvarAsync()
    {
        salvando = true;
        erroSalvar = string.Empty;
        sucesso = string.Empty;

        try
        {
            await UserService.UpdateOwnProfileAsync(formulario);
            sucesso = "Perfil atualizado com sucesso.";
        }
        catch (HttpRequestException exception)
        {
            erroSalvar = exception.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "Já existe um usuário com esse e-mail ou CPF."
                : "Não foi possível salvar as alterações.";
        }
        finally
        {
            salvando = false;
        }
    }
}
